/dev/block/mmcblk0p3  /system   ext4    ro,barrier=1                     wait
/dev/block/mmcblk0p8  /data     ext4    noatime,nosuid,nodev,barrier=1    wait,check
/dev/block/mmcblk0p4  /cache    ext4    noatime,nosuid,nodev,barrier=1    wait,check
/dev/block/mmcblk1p1  /mnt/sdcard vfat defaults                          wait,voldmanaged=sdcard:auto
/dev/block/mmcblk0p2  /boot      emmc    defaults                         defaults
/dev/block/mmcblk0p1  /recovery  emmc    defaults                         defaults
