import init.picasso.usb.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug

on fs
    mount_all /fstab.picasso

on post-fs-data
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp

    # emulated sdcard lives on /data/media, managed by vold
    mkdir /data/media 0775 media_rw media_rw
    chown media_rw media_rw /data/media

    setprop vold.post_fs_data_done 1

on boot
# bluetooth (BCM4329 UART; patchram blob not shipped yet)
    chmod 0660 /dev/ttyHS2
    chown bluetooth bluetooth /dev/ttyHS2
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type
    setprop ro.bt.bdaddr_path /sys/EcControl/BTMAC
    chown bluetooth bluetooth /sys/EcControl/BTMAC

# backlight
    chown system system /sys/class/backlight/pwm-backlight/brightness

# EC-controlled notification LED
    chown system system /sys/EcControl/HomekeyLED

# touch (atmel mxt via sec class)
    chown system system /sys/Touch/sensitivity
    chown system system /sys/Touch/filter

# nvidia device nodes used by graphics/sensors blobs
    chmod 0666 /dev/nvhost-ctrl
    chmod 0666 /dev/nvhost-display
    chmod 0666 /dev/nvhost-gr2d
    chmod 0666 /dev/nvhost-gr3d
    chmod 0666 /dev/nvhost-mpe
    chmod 0666 /dev/nvhost-vi

# power management
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 216000
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1000000
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_min_freq 216000
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_max_freq 1000000
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/interactive/go_maxspeed_load 80

# wifi-only SKU: no modem
on property:ro.carrier=wifi-only
    stop ril-daemon

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
#   we will start as root and wpa_supplicant will switch to user wifi
#   after setting up the capabilities required for WEXT
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# PICASSO: WifiNative (7.1, p2p_supported=true) стартует именно p2p_supplicant
service p2p_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf \
    -puse_p2p_group_interface=1 \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
