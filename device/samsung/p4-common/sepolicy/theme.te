# picasso: темы (ThemeInterfacer) — перенесено из system/sepolicy/private/app.te
allow appdomain theme_data_file:dir { open getattr read search ioctl lock };
allow appdomain theme_data_file:file { getattr open read ioctl lock map };
allow appdomain theme_data_file:dir r_dir_perms;
allow appdomain theme_data_file:file r_file_perms;
